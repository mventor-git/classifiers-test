# Dependencies and weights live inside the repo folder so the project is
# self-contained, but multi-gigabyte binaries do not belong in git history.
# Contract section 6: reproducibility comes from the lockfile, not the blobs.

.venv/
.data/

# Browser profile used by tools/snapshot.py to take the README screenshots.
# Brave HANGS in headless on a fresh profile, so it must be reused, not deleted -
# but it is machine state and must never be committed.
docs/screenshots/_brave_profile/
docs/screenshots/_profile_*/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets must never enter the repo. Contract section 6.
.env
*.key
*.pem
secrets.*

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log
